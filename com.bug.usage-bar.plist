<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bug.usage-bar</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/usage-bar/UsageBar.app/Contents/MacOS/UsageBar</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__HOME__/usage-bar/app.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/usage-bar/app.err</string>
</dict>
</plist>
